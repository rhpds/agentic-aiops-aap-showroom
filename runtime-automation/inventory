[all]
localhost ansible_connection=local

[bastion]
bastion ansible_host=ssh.ocpvdev01.rhdp.net ansible_port=31110 ansible_user=lab-user ansible_ssh_private_key_file=/opt/app-root/src/.ssh/id_rsa ansible_ssh_common_args="-o StrictHostKeyChecking=no"

[node1_via_bastion]
node1 ansible_host=node1 ansible_user=cloud-user ansible_ssh_private_key_file=/opt/app-root/src/.ssh/id_rsa ansible_ssh_common_args="-o StrictHostKeyChecking=no -o ProxyJump=bastion"
